/-!
# Matrix–vector lower bounds for linear systems

The probabilistic core of Shamir's lower bound for linear systems ([Shamir2026, Section 3]): for
$\mathbf{d}$ a Chebyshev two-interval spectrum (`NLAlib.IsChebyshevTwoIntervalSpectrum`), a uniform
unit vector $\boldsymbol{\xi}$ and an independent standard Gaussian block $\mathbf{G}$, with
probability at least $3/4$ no vector of the block Krylov space of $\operatorname{diag}(\mathbf{d})$
generated by $[\boldsymbol{\xi}, \mathbf{G}]$ has residual
$\|\boldsymbol{\xi} - \operatorname{diag}(\mathbf{d})\mathbf{x}\|$ below
$\tfrac14 e^{-2s/\kappa}$. On every level of $\mathbf{d}$ the part of $\boldsymbol{\xi}$
orthogonal to the Gaussian columns survives, and the Chebyshev dual weights turn this into the
bound. The algorithmic lower bounds built on it (through the Krylov coupling of a hidden rotation)
are proved below.

## Main results

* `NLAlib.IsChebyshevTwoIntervalSpectrum.measureReal_exists_norm_sub_mulVec_lt_le`: Gaussian
  block Krylov spaces do not contain good residuals.
* `NLAlib.IsChebyshevTwoIntervalSpectrum.measureReal_norm_sub_mulVec_lt_le_of_hasLaw_haarFrame`:
  the deterministic hidden-rotation lower bound.
* `NLAlib.IsChebyshevTwoIntervalSpectrum.exists_le_measureReal_norm_sub_mulVec_ge`:
  the randomized worst-case form.
* `NLAlib.mul_log_le_of_forall_le_measureReal_norm_sub_mulVec_le`,
  `NLAlib.mul_log_le_four_mul_add_one_of_forall_le_measureReal_norm_sub_mulVec_le`:
  lower bounds on the number of matrix–vector products.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory
open scoped Matrix

namespace NLAlib

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {μ : Measure Ω} {n : Type*} [Fintype n]
  [DecidableEq n]

omit [DecidableEq n] in
/-- The number of distinct values of a Chebyshev two-interval spectrum of depth $s$ is at most
$s + 2$. -/
private theorem IsChebyshevTwoIntervalSpectrum.card_image_le {κ : ℝ} {s M : ℕ} {d : n → ℝ}
    (hd : IsChebyshevTwoIntervalSpectrum κ s M d) : (Finset.univ.image d).card ≤ s + 2 := by
  classical
  have hsub : Finset.univ.image d ⊆ (Finset.univ : Finset (Fin (s / 2 + 1) × Bool)).image
      fun p => if p.2 then Real.sqrt (chebyshevExtremum 1 (κ ^ 2) (s / 2) p.1)
        else -Real.sqrt (chebyshevExtremum 1 (κ ^ 2) (s / 2) p.1) := by
    intro t ht
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp ht
    obtain ⟨j, hj | hj⟩ := hd.exists_eq i
    · exact Finset.mem_image.mpr ⟨(j, true), Finset.mem_univ _, by simp [hj]⟩
    · exact Finset.mem_image.mpr ⟨(j, false), Finset.mem_univ _, by simp [hj]⟩
  refine (Finset.card_le_card hsub).trans (Finset.card_image_le.trans ?_)
  simp only [Finset.card_univ, Fintype.card_prod, Fintype.card_fin, Fintype.card_bool]
  omega

omit [DecidableEq n] in
/-- Every value of a Chebyshev two-interval spectrum with margin $M$ is taken at least $M$
times. -/
private theorem IsChebyshevTwoIntervalSpectrum.le_card_filter {κ : ℝ} {s M : ℕ} {d : n → ℝ}
    (hd : IsChebyshevTwoIntervalSpectrum κ s M d) (hκ : 2 ≤ κ) {t : ℝ}
    (ht : t ∈ Finset.univ.image d) : M ≤ (Finset.univ.filter fun i => d i = t).card := by
  have hκ2 : 1 < κ ^ 2 := by nlinarith
  have hτ := Polynomial.Chebyshev.one_le_eval_T_real ((s / 2 : ℕ) : ℤ)
    (show 1 ≤ (κ ^ 2 + 1) / (κ ^ 2 - 1) by rw [le_div_iff₀ (by linarith)]; linarith)
  obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp ht
  obtain ⟨j, hj | hj⟩ := hd.exists_eq i
  all_goals
    have hw := chebyshevWeight_pos one_pos hκ2 (s / 2) j
    have h0 : 0 ≤ (Fintype.card n : ℝ) / 4 * (chebyshevWeight 1 (κ ^ 2) (s / 2) j /
        (2 * (Polynomial.Chebyshev.T ℝ ((s / 2 : ℕ) : ℤ)).eval ((κ ^ 2 + 1) / (κ ^ 2 - 1)))) := by
      positivity
  · have := hd.le_card_pos j
    rw [hj]
    exact_mod_cast (le_add_of_nonneg_left h0).trans this
  · have := hd.le_card_neg j
    rw [hj]
    exact_mod_cast (le_add_of_nonneg_left h0).trans this

/-- Deterministic step: on the good event no Krylov vector has a small residual. -/
private theorem IsChebyshevTwoIntervalSpectrum.le_norm_sub_mulVec_of_forall {κ : ℝ} {s M : ℕ}
    {d : n → ℝ} (hd : IsChebyshevTwoIntervalSpectrum κ s M d) (hκ : 2 ≤ κ) {c : Type*}
    [Fintype c] (hc : Fintype.card c ≤ M) {v : n → ℝ} {G : Matrix n c ℝ}
    (hgood : ∀ t ∈ Finset.univ.image d,
      (((Finset.univ.filter fun i => d i = t).card : ℝ) - Fintype.card c) *
          ‖WithLp.toLp 2 v‖ ^ 2 <
        4 * Fintype.card n * ‖WithLp.toLp 2
          ((1 - rangeProjector (G.submatrix (Subtype.val : {i // d i = t} → n) id)) *ᵥ
            fun i => v i.1)‖ ^ 2)
    {x : n → ℝ} (hx : x ∈ blockKrylovSpace (Matrix.diagonal d)
      (Matrix.fromCols (Matrix.replicateCol Unit v) G) s) :
    Real.exp (-(2 * s / κ)) / 4 * ‖WithLp.toLp 2 v‖ ≤
      ‖WithLp.toLp 2 (v - Matrix.diagonal d *ᵥ x)‖ := by
  rcases (norm_nonneg (WithLp.toLp 2 v)).eq_or_lt with h0 | hpos
  · rw [← h0, mul_zero]
    exact norm_nonneg _
  obtain ⟨i, -⟩ := Function.ne_iff.mp (fun h : v = 0 => by simp [h] at hpos)
  have hn : (0 : ℝ) < Fintype.card n := Nat.cast_pos.mpr (Fintype.card_pos_iff.mpr ⟨i⟩)
  obtain ⟨r, hr, hr0, hsum⟩ := exists_sum_eval_sq_mul_norm_sq_le_norm_sub_mulVec_sq d v G hx
  have hP7 := hd.inv_sq_le_sum_card_sub_mul_eval_sq (by linarith) hr hr0
  set τ := (Polynomial.Chebyshev.T ℝ ((s / 2 : ℕ) : ℤ)).eval ((κ ^ 2 + 1) / (κ ^ 2 - 1))
  have hτ : Real.exp (-(2 * s / κ)) ≤ τ⁻¹ := by
    refine (Real.exp_le_exp.mpr ?_).trans (exp_neg_le_inv_eval_T_real hκ (s / 2))
    have : (4 * ((s / 2 : ℕ) : ℝ)) ≤ 2 * s := by
      have := Nat.mul_div_le s 2
      exact_mod_cast (by omega : 4 * (s / 2) ≤ 2 * s)
    rw [neg_le_neg_iff]
    exact div_le_div_of_nonneg_right this (by linarith)
  have hkey : ‖WithLp.toLp 2 v‖ ^ 2 * ((Fintype.card n : ℝ) / 4 * τ⁻¹ ^ 2) ≤
      4 * Fintype.card n * ‖WithLp.toLp 2 (v - Matrix.diagonal d *ᵥ x)‖ ^ 2 := by
    refine (mul_le_mul_of_nonneg_left hP7 (by positivity)).trans ?_
    rw [Finset.mul_sum]
    refine (Finset.sum_le_sum fun t ht => ?_).trans
      ((Finset.mul_sum _ _ _).symm.trans_le (mul_le_mul_of_nonneg_left hsum (by positivity)))
    have h := hgood t ht
    have hcM : (Fintype.card c : ℝ) ≤ M := by exact_mod_cast hc
    nlinarith [sq_nonneg (r.eval t), mul_le_mul_of_nonneg_left h.le (sq_nonneg (r.eval t)),
      mul_nonneg (sq_nonneg (r.eval t)) (sq_nonneg ‖WithLp.toLp 2 v‖)]
  have hsq : (Real.exp (-(2 * s / κ)) / 4 * ‖WithLp.toLp 2 v‖) ^ 2 ≤
      ‖WithLp.toLp 2 (v - Matrix.diagonal d *ᵥ x)‖ ^ 2 := by
    have h1 : (Real.exp (-(2 * s / κ))) ^ 2 ≤ τ⁻¹ ^ 2 := pow_le_pow_left₀ (by positivity) hτ 2
    nlinarith [mul_le_mul_of_nonneg_left h1 (by positivity : (0 : ℝ) ≤
      Fintype.card n * ‖WithLp.toLp 2 v‖ ^ 2)]
  exact (pow_le_pow_iff_left₀ (by positivity) (norm_nonneg _) two_ne_zero).mp hsq

/-- The numerical bound of the union bound. -/
private theorem add_one_mul_exp_add_exp_le (s : ℕ) :
    ((s : ℝ) + 2) * Real.exp (-(1158 / 1000 * ((s : ℝ) + 2))) +
      Real.exp (-(1836 / 1000 * ((s : ℝ) + 2))) ≤ 1 / 4 := by
  have e1 := Real.exp_one_gt_d9
  have hA : 972 / 100 ≤ Real.exp (2316 / 1000) := by
    rw [show (2316 / 1000 : ℝ) = 1 + 1 + 316 / 1000 by norm_num, Real.exp_add, Real.exp_add]
    nlinarith [Real.add_one_le_exp (316 / 1000 : ℝ), Real.exp_pos 1]
  have hB : 334 / 10 ≤ Real.exp (3672 / 1000) := by
    rw [show (3672 / 1000 : ℝ) = 1 + 1 + 1 + 672 / 1000 by norm_num, Real.exp_add,
      Real.exp_add, Real.exp_add]
    have h2 : 2718 / 1000 * (2718 / 1000) ≤ Real.exp 1 * Real.exp 1 := by nlinarith
    have h3 : 2008 / 100 ≤ Real.exp 1 * Real.exp 1 * Real.exp 1 := by nlinarith
    nlinarith [Real.add_one_le_exp (672 / 1000 : ℝ)]
  have hu := Real.add_one_le_exp (1158 / 1000 * (s : ℝ))
  have hv := Real.exp_nonneg (1836 / 1000 * (s : ℝ))
  have hs : (0 : ℝ) ≤ s := Nat.cast_nonneg s
  rw [show -(1158 / 1000 * ((s : ℝ) + 2)) = -(1158 / 1000 * (s : ℝ) + 2316 / 1000) by ring,
    show -(1836 / 1000 * ((s : ℝ) + 2)) = -(1836 / 1000 * (s : ℝ) + 3672 / 1000) by ring,
    Real.exp_neg, Real.exp_neg, Real.exp_add, Real.exp_add]
  have hX : ((s : ℝ) + 2) * (Real.exp (1158 / 1000 * s) * Real.exp (2316 / 1000))⁻¹ ≤
      2 / (972 / 100) := by
    rw [← div_eq_mul_inv, div_le_div_iff₀ (by positivity) (by norm_num)]
    nlinarith [mul_le_mul hu hA (by norm_num) (Real.exp_nonneg _)]
  have hY : (Real.exp (1836 / 1000 * s) * Real.exp (3672 / 1000))⁻¹ ≤ 1 / (334 / 10) := by
    rw [← one_div, div_le_div_iff₀ (by positivity) (by norm_num)]
    nlinarith [Real.one_le_exp (by positivity : (0 : ℝ) ≤ 1836 / 1000 * s)]
  linarith

omit [DecidableEq n] in
/-- The coordinates of a standard Gaussian vector in a subset form a standard Gaussian vector. -/
private theorem hasLaw_subtype_of_hasLaw_gaussianVector {g : Ω → n → ℝ}
    (hg : HasLaw g (gaussianVector n) μ) (p : n → Prop) [DecidablePred p] :
    HasLaw (fun ω (i : {i // p i}) => g ω i.1) (gaussianVector {i // p i}) μ := by
  classical
  have h := hasLaw_mulVec_of_hasLaw_gaussianVector hg
    (A := (1 : Matrix n n ℝ).submatrix (Subtype.val : {i // p i} → n) id) (by
      rw [HasOrthonormalCols, Matrix.conjTranspose_conjTranspose, Matrix.conjTranspose_submatrix,
        ← Matrix.submatrix_mul _ _ _ _ _ Function.bijective_id, Matrix.conjTranspose_one,
        Matrix.one_mul, Matrix.submatrix_one _ Subtype.val_injective])
  convert h using 2 with ω
  ext i
  simp [Matrix.mulVec, dotProduct, Matrix.one_apply]

/-- Probabilistic step: for a Gaussian vector independent of a Gaussian matrix the good event
fails with probability at most $1/4$. -/
private theorem IsChebyshevTwoIntervalSpectrum.measureReal_not_forall_le {κ : ℝ} {s M : ℕ}
    {d : n → ℝ} (hd : IsChebyshevTwoIntervalSpectrum κ s M d) (hκ : 2 ≤ κ) {c : Type*}
    [Fintype c] (hc : Fintype.card c + 12 * (s + 2) ≤ M) {g : Ω → n → ℝ}
    (hg : HasLaw g (gaussianVector n) μ) {G : Ω → Matrix n c ℝ}
    (hG : HasLaw G (gaussianMatrix n c) μ) (hgG : IndepFun g G μ) :
    μ.real {ω | ¬ ∀ t ∈ Finset.univ.image d,
      (((Finset.univ.filter fun i => d i = t).card : ℝ) - Fintype.card c) *
          ‖WithLp.toLp 2 (g ω)‖ ^ 2 <
        4 * Fintype.card n * ‖WithLp.toLp 2
          ((1 - rangeProjector ((G ω).submatrix (Subtype.val : {i // d i = t} → n) id)) *ᵥ
            fun i => g ω i.1)‖ ^ 2} ≤ 1 / 4 := by
  classical
  have := hg.isProbabilityMeasure
  rcases isEmpty_or_nonempty n with hn | hn
  · simp [Finset.univ_eq_empty]
  obtain ⟨i₀⟩ := id hn
  have hM : ∀ t ∈ Finset.univ.image d, M ≤ (Finset.univ.filter fun i => d i = t).card :=
    fun t ht => hd.le_card_filter hκ ht
  have hnM : (M : ℝ) ≤ Fintype.card n := by
    exact_mod_cast (hM _ (Finset.mem_image_of_mem d (Finset.mem_univ i₀))).trans
      (Finset.card_le_univ _)
  set r : ℝ → ℕ := fun t => (Finset.univ.filter fun i => d i = t).card - Fintype.card c with hr
  have hsub : {ω | ¬ ∀ t ∈ Finset.univ.image d,
      (((Finset.univ.filter fun i => d i = t).card : ℝ) - Fintype.card c) *
          ‖WithLp.toLp 2 (g ω)‖ ^ 2 <
        4 * Fintype.card n * ‖WithLp.toLp 2
          ((1 - rangeProjector ((G ω).submatrix (Subtype.val : {i // d i = t} → n) id)) *ᵥ
            fun i => g ω i.1)‖ ^ 2} ⊆
      {ω | (2 : ℝ) * Fintype.card n ≤ ‖WithLp.toLp 2 (g ω)‖ ^ 2} ∪
        ⋃ t ∈ Finset.univ.image d, {ω | ‖WithLp.toLp 2
          ((1 - rangeProjector ((G ω).submatrix (Subtype.val : {i // d i = t} → n) id)) *ᵥ
            fun i => g ω i.1)‖ ^ 2 ≤ 1 / 2 * (r t : ℝ)} := by
    intro ω hω
    simp only [Set.mem_ofPred_eq, not_forall, not_lt, exists_prop] at hω
    obtain ⟨t, ht, h⟩ := hω
    rcases le_or_gt ((2 : ℝ) * Fintype.card n) (‖WithLp.toLp 2 (g ω)‖ ^ 2) with h2 | h2
    · exact Or.inl h2
    refine Or.inr (Set.mem_biUnion ht ?_)
    simp only [Set.mem_ofPred_eq, hr]
    have hcm : Fintype.card c ≤ (Finset.univ.filter fun i => d i = t).card := by
      have := hM t ht; omega
    rw [Nat.cast_sub hcm]
    have h0 : (0 : ℝ) ≤ ((Finset.univ.filter fun i => d i = t).card : ℝ) - Fintype.card c := by
      have : (Fintype.card c : ℝ) ≤ (Finset.univ.filter fun i => d i = t).card := by
        exact_mod_cast hcm
      linarith
    have hn : (0 : ℝ) < Fintype.card n := Nat.cast_pos.mpr Fintype.card_pos
    nlinarith [mul_le_mul_of_nonneg_left h2.le h0]
  have hlog := And.intro Real.log_two_gt_d9 Real.log_two_lt_d9
  have hchi : μ.real {ω | (2 : ℝ) * Fintype.card n ≤ ‖WithLp.toLp 2 (g ω)‖ ^ 2} ≤
      Real.exp (-(1836 / 1000 * ((s : ℝ) + 2))) := by
    refine (measureReal_norm_sq_ge_mul_card_le_of_hasLaw_gaussianVector hg one_le_two).trans
      (Real.exp_le_exp.mpr ?_)
    have : ((M : ℝ)) ≥ 12 * ((s : ℝ) + 2) := by exact_mod_cast (by omega : 12 * (s + 2) ≤ M)
    nlinarith
  have hlev : ∀ t ∈ Finset.univ.image d, μ.real {ω | ‖WithLp.toLp 2
          ((1 - rangeProjector ((G ω).submatrix (Subtype.val : {i // d i = t} → n) id)) *ᵥ
            fun i => g ω i.1)‖ ^ 2 ≤ 1 / 2 * (r t : ℝ)} ≤
      Real.exp (-(1158 / 1000 * ((s : ℝ) + 2))) := by
    intro t ht
    have hP : Measurable fun A : Matrix n c ℝ =>
        1 - rangeProjector (A.submatrix (Subtype.val : {i // d i = t} → n) id) :=
      measurable_const.sub (measurable_rangeProjector.comp (by fun_prop))
    refine (measureReal_norm_mulVec_sq_le_mul_le_of_hasLaw_gaussianVector_of_indepFun
      (hasLaw_subtype_of_hasLaw_gaussianVector hg (fun i => d i = t))
      (hP.comp_aemeasurable hG.aemeasurable)
      (hgG.comp (measurable_pi_lambda _ fun i : {i // d i = t} => measurable_pi_apply i.1) hP)
      (fun ω => isStarProjection_one_sub_rangeProjector _) (r := r t) (fun ω => ?_)
      (by norm_num) (by norm_num)).trans (Real.exp_le_exp.mpr ?_)
    · have h1 := rank_one_sub_rangeProjector_add_rank
        ((G ω).submatrix (Subtype.val : {i // d i = t} → n) id)
      have h2 := Matrix.rank_le_card_width ((G ω).submatrix (Subtype.val : {i // d i = t} → n) id)
      rw [Fintype.card_subtype] at h1
      change r t ≤
        (1 - rangeProjector ((G ω).submatrix (Subtype.val : {i // d i = t} → n) id)).rank
      simp only [hr]
      omega
    · have hrt : (12 : ℝ) * ((s : ℝ) + 2) ≤ r t := by
        exact_mod_cast (by have := hM t ht; simp only [hr]; omega : 12 * (s + 2) ≤ r t)
      rw [one_div, Real.log_inv]
      nlinarith
  calc _ ≤ _ := measureReal_mono hsub
    _ ≤ _ := measureReal_union_le _ _
    _ ≤ Real.exp (-(1836 / 1000 * ((s : ℝ) + 2))) +
        ∑ t ∈ Finset.univ.image d, Real.exp (-(1158 / 1000 * ((s : ℝ) + 2))) :=
      add_le_add hchi ((measureReal_biUnion_finset_le _ _).trans (Finset.sum_le_sum hlev))
    _ ≤ 1 / 4 := by
      rw [Finset.sum_const, nsmul_eq_mul]
      have : ((Finset.univ.image d).card : ℝ) ≤ s + 2 := by exact_mod_cast hd.card_image_le
      nlinarith [add_one_mul_exp_add_exp_le s, Real.exp_pos (-(1158 / 1000 * ((s : ℝ) + 2)))]

omit [DecidableEq n] in
/-- The index type of a Chebyshev two-interval spectrum with a positive margin is nonempty. -/
private theorem IsChebyshevTwoIntervalSpectrum.nonempty {κ : ℝ} {s M : ℕ} {d : n → ℝ}
    (hd : IsChebyshevTwoIntervalSpectrum κ s M d) (hM : 0 < M) : Nonempty n := by
  by_contra h
  have := hd.le_card_pos 0
  rw [not_nonempty_iff] at h
  simp only [Fintype.card_eq_zero, Nat.cast_zero, zero_div, zero_mul, zero_add,
    Finset.univ_eq_empty, Finset.filter_empty, Finset.card_empty] at this
  norm_cast at this
  omega

/-- **Gaussian block Krylov spaces do not solve a Chebyshev two-interval system**: let $\mathbf{d}$
be a Chebyshev two-interval spectrum for $\kappa \ge 2$ with depth $s$ and margin $M$,
$\mathbf{D} = \operatorname{diag}(\mathbf{d})$, $\boldsymbol{\xi}$ uniform on the unit sphere and
$\mathbf{G}$ a standard Gaussian $n \times c$ matrix independent of $\boldsymbol{\xi}$, with
$\lvert c \rvert + 12(s + 2) \le M$. Then
$$\mathbb{P}\Bigl[\exists\,\mathbf{x} \in \mathcal{K}_s(\mathbf{D}, [\boldsymbol{\xi}, \mathbf{G}]):
\ \|\boldsymbol{\xi} - \mathbf{D}\mathbf{x}\| < \tfrac14 e^{-2s/\kappa}\Bigr] \le \frac14 \,.$$
[Shamir2026, Section 3.3]; there for a Gaussian $\mathbf{g}$ in place of $\boldsymbol{\xi}$, with
$\|\mathbf{g}\|$ in the bound and the constants $\tfrac34$, $0.9$; the event is scale invariant,
so the two forms are equivalent. -/
theorem IsChebyshevTwoIntervalSpectrum.measureReal_exists_norm_sub_mulVec_lt_le
    {κ : ℝ} {s M : ℕ} {d : n → ℝ} (hd : IsChebyshevTwoIntervalSpectrum κ s M d) (hκ : 2 ≤ κ)
    {c : Type*} [Fintype c] (hc : Fintype.card c + 12 * (s + 2) ≤ M) {ξ : Ω → n → ℝ}
    (hξ : HasLaw ξ (uniformSphereVector n) μ) {G : Ω → Matrix n c ℝ}
    (hG : HasLaw G (gaussianMatrix n c) μ) (hξG : IndepFun ξ G μ) :
    μ.real {ω | ∃ x ∈ blockKrylovSpace (Matrix.diagonal d)
        (Matrix.fromCols (Matrix.replicateCol Unit (ξ ω)) (G ω)) s,
        ‖WithLp.toLp 2 (ξ ω - Matrix.diagonal d *ᵥ x)‖ < Real.exp (-(2 * s / κ)) / 4} ≤
      1 / 4 := by
  classical
  have := hG.isProbabilityMeasure
  set S : Set ((n → ℝ) × Matrix n c ℝ) := {p | ∀ t ∈ Finset.univ.image d,
      (((Finset.univ.filter fun i => d i = t).card : ℝ) - Fintype.card c) *
          ‖WithLp.toLp 2 p.1‖ ^ 2 <
        4 * Fintype.card n * ‖WithLp.toLp 2
          ((1 - rangeProjector (p.2.submatrix (Subtype.val : {i // d i = t} → n) id)) *ᵥ
            fun i => p.1 i.1)‖ ^ 2} with hS_def
  set F : Set ((n → ℝ) × Matrix n c ℝ) := Sᶜ ∪ {p | ‖WithLp.toLp 2 p.1‖ < 1} with hF_def
  set ν := (gaussianVector n).prod (gaussianMatrix n c) with hν
  set N : (n → ℝ) × Matrix n c ℝ → (n → ℝ) × Matrix n c ℝ :=
    Prod.map (fun g : n → ℝ => ‖WithLp.toLp 2 g‖⁻¹ • g) id with hN
  have hS : MeasurableSet S := by
    convert (Finset.univ.image d).measurableSet_biInter fun t _ => measurableSet_lt
      (f := fun p : (n → ℝ) × Matrix n c ℝ =>
        (((Finset.univ.filter fun i => d i = t).card : ℝ) - Fintype.card c) *
          ‖WithLp.toLp 2 p.1‖ ^ 2)
      (g := fun p : (n → ℝ) × Matrix n c ℝ => 4 * Fintype.card n * ‖WithLp.toLp 2
          ((1 - rangeProjector (p.2.submatrix (Subtype.val : {i // d i = t} → n) id)) *ᵥ
            fun i => p.1 i.1)‖ ^ 2) (by fun_prop) ?_ using 1
    · ext p
      simp only [hS_def, Set.mem_ofPred_eq, Set.mem_iInter]
    · have h1 : Measurable fun p : (n → ℝ) × Matrix n c ℝ =>
          rangeProjector (p.2.submatrix (Subtype.val : {i // d i = t} → n) id) :=
        measurable_rangeProjector.comp (by fun_prop)
      fun_prop
  have hF : MeasurableSet F :=
    hS.compl.union (measurableSet_lt (by fun_prop) measurable_const)
  have hsub : {ω | ∃ x ∈ blockKrylovSpace (Matrix.diagonal d)
        (Matrix.fromCols (Matrix.replicateCol Unit (ξ ω)) (G ω)) s,
        ‖WithLp.toLp 2 (ξ ω - Matrix.diagonal d *ᵥ x)‖ < Real.exp (-(2 * s / κ)) / 4} ⊆
      (fun ω => (ξ ω, G ω)) ⁻¹' F := by
    rintro ω ⟨x, hx, hlt⟩
    by_contra h
    simp only [hF_def, Set.mem_preimage, Set.mem_union, Set.mem_compl_iff, Set.mem_ofPred_eq,
      not_or, not_not, not_lt] at h
    have := hd.le_norm_sub_mulVec_of_forall hκ (by omega) h.1 hx
    have : Real.exp (-(2 * s / κ)) / 4 ≤ Real.exp (-(2 * s / κ)) / 4 * ‖WithLp.toLp 2 (ξ ω)‖ :=
      le_mul_of_one_le_right (by positivity) h.2
    linarith
  have hlaw : μ.map (fun ω => (ξ ω, G ω)) = (uniformSphereVector n).prod (gaussianMatrix n c) := by
    rw [(indepFun_iff_map_prod_eq_prod_map_map hξ.aemeasurable hG.aemeasurable).mp hξG,
      hξ.map_eq, hG.map_eq]
  have hprod : (uniformSphereVector n).prod (gaussianMatrix n c) = ν.map N := by
    rw [hN, hν, ← Measure.map_prod_map _ _ measurable_inv_norm_smul measurable_id, Measure.map_id]
    rfl
  have hpre : N ⁻¹' F ⊆ Sᶜ := by
    rintro ⟨g, H⟩ hp hgS
    obtain ⟨i₀⟩ := hd.nonempty (by omega)
    rcases eq_or_ne g 0 with rfl | hg
    · have := hgS (d i₀) (Finset.mem_image_of_mem _ (Finset.mem_univ _))
      rw [show (fun _ : {i // d i = d i₀} => ((0 : n → ℝ) _ : ℝ)) = 0 from rfl] at this
      simp at this
    · have ha : 0 < ‖WithLp.toLp 2 g‖ := norm_pos_iff.mpr (by simpa using hg)
      simp only [hF_def, hN, Set.mem_preimage, Prod.map_apply, id_eq, Set.mem_union,
        Set.mem_compl_iff, Set.mem_ofPred_eq, WithLp.toLp_smul, norm_smul, norm_inv, norm_norm,
        inv_mul_cancel₀ ha.ne', lt_irrefl, or_false] at hp
      refine hp fun t ht => ?_
      have h := hgS t ht
      simp only [Pi.smul_apply, WithLp.toLp_smul, norm_smul, norm_inv, norm_norm]
      rw [show (fun i : {i // d i = t} => ‖WithLp.toLp 2 g‖⁻¹ • g i.1) =
        ‖WithLp.toLp 2 g‖⁻¹ • fun i => g i.1 from rfl, Matrix.mulVec_smul, WithLp.toLp_smul,
        norm_smul, norm_inv, norm_norm]
      have : 0 < ‖WithLp.toLp 2 g‖⁻¹ ^ 2 := by positivity
      nlinarith [mul_lt_mul_of_pos_left h this]
  have hν1 : ν.real Sᶜ ≤ 1 / 4 :=
    hd.measureReal_not_forall_le hκ hc (g := Prod.fst) (G := Prod.snd)
      ⟨measurable_fst.aemeasurable, by simp [hν]⟩ ⟨measurable_snd.aemeasurable, by simp [hν]⟩
      ((indepFun_iff_map_prod_eq_prod_map_map measurable_fst.aemeasurable
        measurable_snd.aemeasurable).mpr (by simp [hν]))
  calc _ ≤ μ.real ((fun ω => (ξ ω, G ω)) ⁻¹' F) := measureReal_mono hsub
    _ = (ν.map N).real F := by
      rw [← hprod, ← hlaw, measureReal_def, measureReal_def,
        Measure.map_apply_of_aemeasurable (hξ.aemeasurable.prodMk hG.aemeasurable) hF]
    _ = ν.real (N ⁻¹' F) :=
      map_measureReal_apply (measurable_inv_norm_smul.prodMap measurable_id) hF
    _ ≤ ν.real Sᶜ := measureReal_mono hpre
    _ ≤ 1 / 4 := hν1

/-- The lower bound of
`NLAlib.IsChebyshevTwoIntervalSpectrum.measureReal_norm_sub_mulVec_lt_le_of_hasLaw_haarFrame` on a
space carrying a standard Gaussian $n \times (q + 1)$ matrix independent of $\mathbf{U}$. -/
private theorem IsChebyshevTwoIntervalSpectrum.measureReal_norm_sub_mulVec_lt_le_of_indepFun
    {κ : ℝ} {q : ℕ} {d : n → ℝ} (hd : IsChebyshevTwoIntervalSpectrum κ (q + 1) (13 * (q + 3)) d)
    (hκ : 2 ≤ κ) {alg : QueryAlgorithm (n → ℝ) ((n → ℝ) × (n → ℝ)) q (n → ℝ)}
    (halg : alg.IsMeasurable) {b : n → ℝ} (hb : b ≠ 0) {U : Ω → Matrix n n ℝ}
    (hU : HasLaw U (haarFrame n n) μ) {Z : Ω → Matrix n (Fin q ⊕ Unit) ℝ}
    (hZ : HasLaw Z (gaussianMatrix n (Fin q ⊕ Unit)) μ) (hUZ : IndepFun U Z μ) :
    μ.real {ω | ‖WithLp.toLp 2 (b - (U ω * Matrix.diagonal d * (U ω)ᴴ) *ᵥ
        alg.run (hiddenRotationOracle (U ω) (Matrix.diagonal d)))‖ <
        Real.exp (-(2 * (q + 1) / κ)) / 4 * ‖WithLp.toLp 2 b‖} ≤ 1 / 4 := by
  have hIP := hU.isProbabilityMeasure
  have hb0 : 0 < ‖WithLp.toLp 2 b‖ := norm_pos_iff.2 (by simpa using hb)
  obtain ⟨G, hG⟩ := (QueryAlgorithm.isPassStructured_id alg).mapOutput (Matrix.replicateCol Unit)
    |>.exists_isKrylovCoupling_of_hasLaw_haarFrame (p := q) (fun i hi => hi)
    (halg.mapOutput (by fun_prop)) (Matrix.diagonal d) (Matrix.replicateCol Unit b) hU hZ hUZ
  set ξ : Ω → n → ℝ := fun ω => ‖WithLp.toLp 2 b‖⁻¹ • ((U ω)ᴴ *ᵥ b) with hξdef
  have hξ : HasLaw ξ (uniformSphereVector n) μ := by
    have h := hasLaw_conjTranspose_mulVec_of_hasLaw_haarFrame hU hasOrthonormalCols_one
      (x := ‖WithLp.toLp 2 b‖⁻¹ • b) (by
        rw [WithLp.toLp_smul, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hb0.ne'])
    simp only [Matrix.conjTranspose_one, Matrix.one_mulVec, Measure.map_id',
      Matrix.mulVec_smul] at h
    exact h
  have hξG : IndepFun ξ G μ := by
    have h : ξ = (fun M : Matrix n Unit ℝ => ‖WithLp.toLp 2 b‖⁻¹ • fun i => M i ()) ∘
        fun ω => (U ω)ᴴ * Matrix.replicateCol Unit b := by
      funext ω i
      simp [ξ, Matrix.mul_apply, Matrix.mulVec, dotProduct]
    rw [h]
    exact hG.indepFun.comp (by fun_prop) measurable_id
  refine (measureReal_mono_ae ?_).trans
    (hd.measureReal_exists_norm_sub_mulVec_lt_le hκ (c := Fin q ⊕ Unit)
      (by simp; omega) hξ hG.hasLaw_gaussianMatrix hξG)
  filter_upwards [hG.ae_range_le, ae_hasOrthonormalCols_of_hasLaw_haarFrame hU le_rfl]
    with ω hr hO hω
  simp only [QueryAlgorithm.run_mapOutput] at hr
  change _ < _ at hω
  change ∃ _, _
  set x := alg.run (hiddenRotationOracle (U ω) (Matrix.diagonal d))
  set c := ‖WithLp.toLp 2 b‖
  refine ⟨c⁻¹ • ((U ω)ᴴ *ᵥ x), Submodule.smul_mem _ _ ?_, ?_⟩
  · -- `Uᴴ x` is in the Krylov space of `[Uᴴ b, G]`, which is that of `[ξ, G]`
    have hmem : (U ω)ᴴ *ᵥ x ∈ LinearMap.range ((U ω)ᴴ * Matrix.replicateCol Unit x).mulVecLin :=
      ⟨fun _ => 1, by
        rw [Matrix.mulVecLin_apply, ← Matrix.mulVec_mulVec]
        congr 1
        ext i
        simp [Matrix.mulVec, dotProduct]⟩
    refine blockKrylovSpace_le_of_range_le ?_ (q + 1) (hr hmem)
    rw [show Matrix.fromCols ((U ω)ᴴ * Matrix.replicateCol Unit b) (G ω) =
        Matrix.fromCols (Matrix.replicateCol Unit (ξ ω)) (G ω) *
          Matrix.diagonal (Sum.elim (fun _ => c) fun _ => 1) from ?_, Matrix.mulVecLin_mul]
    · exact LinearMap.range_comp_le_range _ _
    · ext i (j | j)
      · simp [hξdef, Matrix.mul_apply, Matrix.mulVec, dotProduct]
        field_simp
      · simp [Matrix.mul_diagonal]
  · -- the residual is `c⁻¹ • Uᴴ (b - A x)`, and `Uᴴ` is a contraction
    have heq : ξ ω - Matrix.diagonal d *ᵥ (c⁻¹ • ((U ω)ᴴ *ᵥ x)) =
        c⁻¹ • ((U ω)ᴴ *ᵥ (b - (U ω * Matrix.diagonal d * (U ω)ᴴ) *ᵥ x)) := by
      rw [Matrix.mulVec_sub, Matrix.mulVec_mulVec, show (U ω)ᴴ * (U ω * Matrix.diagonal d *
          (U ω)ᴴ) = Matrix.diagonal d * (U ω)ᴴ by
          rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, hO.conjTranspose_mul_self, Matrix.one_mul],
        ← Matrix.mulVec_mulVec, Matrix.mulVec_smul, smul_sub]
    rw [heq, WithLp.toLp_smul, norm_smul, norm_inv, norm_norm, inv_mul_lt_iff₀ hb0]
    refine ((norm_toLp_mulVec_le _ _).trans (mul_le_of_le_one_left (norm_nonneg _) ?_)).trans_lt ?_
    · rw [specNorm_conjTranspose]
      exact hO.specNorm_le_one
    · push_cast
      linarith

/-- **Shamir's lower bound for one deterministic algorithm**: let $\mathbf{d}$ be a Chebyshev
two-interval spectrum for $\kappa \ge 2$ with depth $q + 1$ and margin $13(q + 3)$,
$\mathbf{U}$ Haar on the orthogonal $n \times n$ matrices and
$\mathbf{A} = \mathbf{U}\operatorname{diag}(\mathbf{d})\mathbf{U}^{\mathsf{H}}$. For every
$\mathbf{b} \ne \mathbf{0}$ and every measurable algorithm making $q$ adaptive queries to
$\mathbf{x} \mapsto (\mathbf{A}\mathbf{x}, \mathbf{U}^{\mathsf{H}}\mathbf{x})$ with output
$\hat{\mathbf{x}}$ (it may depend on $\mathbf{b}$ and $\mathbf{d}$ in any way),
$$\mathbb{P}\Bigl[\|\mathbf{b} - \mathbf{A}\hat{\mathbf{x}}\| <
\tfrac14 e^{-2(q+1)/\kappa}\|\mathbf{b}\|\Bigr] \le \frac14 \,.$$
[Shamir2026, Theorem 1, Section 3.3]; there with $\mathbf{b}$ Gaussian and the output the last
query; here every fixed $\mathbf{b} \ne \mathbf{0}$ and a separate output (one more degree). -/
theorem IsChebyshevTwoIntervalSpectrum.measureReal_norm_sub_mulVec_lt_le_of_hasLaw_haarFrame
    {κ : ℝ} {q : ℕ} {d : n → ℝ} (hd : IsChebyshevTwoIntervalSpectrum κ (q + 1) (13 * (q + 3)) d)
    (hκ : 2 ≤ κ) {alg : QueryAlgorithm (n → ℝ) ((n → ℝ) × (n → ℝ)) q (n → ℝ)}
    (halg : alg.IsMeasurable) {b : n → ℝ} (hb : b ≠ 0) {U : Ω → Matrix n n ℝ}
    (hU : HasLaw U (haarFrame n n) μ) :
    μ.real {ω | ‖WithLp.toLp 2 (b - (U ω * Matrix.diagonal d * (U ω)ᴴ) *ᵥ
        alg.run (hiddenRotationOracle (U ω) (Matrix.diagonal d)))‖ <
        Real.exp (-(2 * (q + 1) / κ)) / 4 * ‖WithLp.toLp 2 b‖} ≤ 1 / 4 := by
  have hmeas : MeasurableSet {V : Matrix n n ℝ | ‖WithLp.toLp 2 (b - (V * Matrix.diagonal d * Vᴴ) *ᵥ
      alg.run (hiddenRotationOracle V (Matrix.diagonal d)))‖ <
      Real.exp (-(2 * (q + 1) / κ)) / 4 * ‖WithLp.toLp 2 b‖} := by
    have hrun := halg.measurable_run (O := fun V => hiddenRotationOracle V (Matrix.diagonal d))
      (Measurable.hiddenRotationOracle measurable_fst measurable_snd (Matrix.diagonal d))
    refine measurableSet_lt ?_ measurable_const
    exact (continuous_norm.comp (PiLp.continuous_toLp 2 _)).measurable.comp
      (measurable_const.sub
        (Measurable.hiddenRotationOracle measurable_id hrun (Matrix.diagonal d)).fst)
  have hfst := (measurePreserving_fst (μ := haarFrame n n)
    (ν := gaussianMatrix n (Fin q ⊕ Unit))).hasLaw
  rw [hU.measureReal_eq hmeas, ← hfst.measureReal_eq hmeas]
  exact hd.measureReal_norm_sub_mulVec_lt_le_of_indepFun hκ halg hb hfst
    measurePreserving_snd.hasLaw (indepFun_prod measurable_id measurable_id)

/-- **Shamir's lower bound, randomized worst case**: let $\mathbf{d}$ be a Chebyshev two-interval
spectrum for $\kappa \ge 2$ with depth $q + 1$ and margin $13(q + 3)$. For every randomized
algorithm (a measurable seeded family, seed law $\rho$) making $q$ adaptive queries to
$\mathbf{x} \mapsto (\mathbf{A}\mathbf{x}, \mathbf{U}^{\mathsf{H}}\mathbf{x})$ and every
$\mathbf{b} \ne \mathbf{0}$ there is an orthogonal $\mathbf{U}$ such that, for
$\mathbf{A} = \mathbf{U}\operatorname{diag}(\mathbf{d})\mathbf{U}^{\mathsf{H}}$,
$$\mathbb{P}_s\Bigl[\|\mathbf{b} - \mathbf{A}\hat{\mathbf{x}}_s\| \ge
\tfrac14 e^{-2(q+1)/\kappa}\|\mathbf{b}\|\Bigr] \ge \frac34 \,.$$
[Shamir2026, Theorem 1]. -/
theorem IsChebyshevTwoIntervalSpectrum.exists_le_measureReal_norm_sub_mulVec_ge {κ : ℝ} {q : ℕ}
    {d : n → ℝ} (hd : IsChebyshevTwoIntervalSpectrum κ (q + 1) (13 * (q + 3)) d) (hκ : 2 ≤ κ)
    {S : Type*} [MeasurableSpace S]
    {alg : S → QueryAlgorithm (n → ℝ) ((n → ℝ) × (n → ℝ)) q (n → ℝ)}
    (halg : QueryAlgorithm.IsMeasurableFamily alg) (ρ : Measure S) [IsProbabilityMeasure ρ]
    {b : n → ℝ} (hb : b ≠ 0) :
    ∃ U : Matrix n n ℝ, HasOrthonormalCols U ∧
      3 / 4 ≤ ρ.real {s | Real.exp (-(2 * (q + 1) / κ)) / 4 * ‖WithLp.toLp 2 b‖ ≤
        ‖WithLp.toLp 2 (b - (U * Matrix.diagonal d * Uᴴ) *ᵥ
          (alg s).run (hiddenRotationOracle U (Matrix.diagonal d)))‖} := by
  set c : ℝ := Real.exp (-(2 * (q + 1) / κ)) / 4 * ‖WithLp.toLp 2 b‖
  have hO : Measurable (Function.uncurry fun U : Matrix n n ℝ =>
      hiddenRotationOracle U (Matrix.diagonal d)) := by
    change Measurable fun p : Matrix n n ℝ × (n → ℝ) =>
      hiddenRotationOracle p.1 (Matrix.diagonal d) p.2
    unfold hiddenRotationOracle
    fun_prop
  have hg : Continuous fun p : Matrix n n ℝ × (n → ℝ) =>
      ‖WithLp.toLp 2 (b - (p.1 * Matrix.diagonal d * p.1ᴴ) *ᵥ p.2)‖ := by
    fun_prop
  have hBm : MeasurableSet {p : Matrix n n ℝ × (n → ℝ) |
      HasOrthonormalCols p.1 ∧
        c ≤ ‖WithLp.toLp 2 (b - (p.1 * Matrix.diagonal d * p.1ᴴ) *ᵥ p.2)‖} :=
    (isClosed_setOf_hasOrthonormalCols.measurableSet.preimage measurable_fst).inter
      (measurableSet_le measurable_const hg.measurable)
  have hkey : ∀ a : QueryAlgorithm (n → ℝ) ((n → ℝ) × (n → ℝ)) q (n → ℝ), a.IsMeasurable →
      3 / 4 ≤ (haarFrame n n).real {U : Matrix n n ℝ | HasOrthonormalCols U ∧
        c ≤ ‖WithLp.toLp 2 (b - (U * Matrix.diagonal d * Uᴴ) *ᵥ
          a.run (hiddenRotationOracle U (Matrix.diagonal d)))‖} := by
    intro a ha
    have hsub : (haarFrame n n).real {U : Matrix n n ℝ |
        ‖WithLp.toLp 2 (b - (U * Matrix.diagonal d * Uᴴ) *ᵥ
          a.run (hiddenRotationOracle U (Matrix.diagonal d)))‖ < c} ≤ 1 / 4 :=
      IsChebyshevTwoIntervalSpectrum.measureReal_norm_sub_mulVec_lt_le_of_hasLaw_haarFrame
        hd hκ ha hb (HasLaw.id (μ := haarFrame n n))
    have hOrth := ae_hasOrthonormalCols_of_hasLaw_haarFrame (HasLaw.id (μ := haarFrame n n))
      le_rfl
    have hr : Measurable fun U : Matrix n n ℝ =>
        a.run (hiddenRotationOracle U (Matrix.diagonal d)) := ha.measurable_run hO
    have hf : Measurable ((fun p : Matrix n n ℝ × (n → ℝ) =>
        ‖WithLp.toLp 2 (b - (p.1 * Matrix.diagonal d * p.1ᴴ) *ᵥ p.2)‖) ∘
          fun U : Matrix n n ℝ => (U, a.run (hiddenRotationOracle U (Matrix.diagonal d)))) :=
      hg.measurable.comp (measurable_id.prodMk hr)
    have hEm : MeasurableSet {U : Matrix n n ℝ |
        ‖WithLp.toLp 2 (b - (U * Matrix.diagonal d * Uᴴ) *ᵥ
          a.run (hiddenRotationOracle U (Matrix.diagonal d)))‖ < c} :=
      measurableSet_lt hf measurable_const
    have hcompl := probReal_compl_eq_one_sub (μ := haarFrame n n) hEm
    have hmono : (haarFrame n n).real {U : Matrix n n ℝ |
        ‖WithLp.toLp 2 (b - (U * Matrix.diagonal d * Uᴴ) *ᵥ
          a.run (hiddenRotationOracle U (Matrix.diagonal d)))‖ < c}ᶜ ≤
        (haarFrame n n).real {U : Matrix n n ℝ | HasOrthonormalCols U ∧
          c ≤ ‖WithLp.toLp 2 (b - (U * Matrix.diagonal d * Uᴴ) *ᵥ
            a.run (hiddenRotationOracle U (Matrix.diagonal d)))‖} :=
      measureReal_mono_ae (hOrth.mono fun U hU hE => ⟨hU, not_lt.1 hE⟩)
    linarith
  obtain ⟨U, hU⟩ := halg.exists_le_measureReal_run_mem hO ρ (haarFrame n n) hBm hkey
  by_cases hUo : HasOrthonormalCols U
  · exact ⟨U, hUo, le_trans hU (measureReal_mono fun s hs => hs.2)⟩
  · simp [hUo] at hU
    linarith

/-- **Shamir's query lower bound, hidden-rotation oracle, spectrum known**: let $\mathbf{d}$ be a
Chebyshev two-interval spectrum for $\kappa \ge 2$ with depth $q + 1$ and margin $13(q + 3)$, and
$\varepsilon > 0$. If a randomized algorithm (a measurable seeded family, seed law $\rho$) making
$q$ adaptive queries to $\mathbf{x} \mapsto (\mathbf{A}\mathbf{x}, \mathbf{U}^{\mathsf{H}}
\mathbf{x})$ returns, for every orthogonal $\mathbf{U}$ and every $\mathbf{b}$, an
$\hat{\mathbf{x}}$ with $\|\mathbf{b} - \mathbf{A}\hat{\mathbf{x}}\| \le \varepsilon\|\mathbf{b}\|$
with probability at least $\tfrac23$, where $\mathbf{A} = \mathbf{U}\operatorname{diag}(\mathbf{d})
\mathbf{U}^{\mathsf{H}}$, then
$$\kappa\log\frac{1}{4\varepsilon} \le 2(q + 1) \,.$$
[Shamir2026, Theorem 1]; there $q \ge c\kappa\log(1/\varepsilon)$ for $\kappa \ge C$,
$\varepsilon \le c$, unspecified constants; here explicit. -/
theorem IsChebyshevTwoIntervalSpectrum.mul_log_le_of_forall_le_measureReal {κ ε : ℝ} {q : ℕ}
    {d : n → ℝ} (hd : IsChebyshevTwoIntervalSpectrum κ (q + 1) (13 * (q + 3)) d) (hκ : 2 ≤ κ)
    (hε : 0 < ε) {S : Type*} [MeasurableSpace S]
    {alg : S → QueryAlgorithm (n → ℝ) ((n → ℝ) × (n → ℝ)) q (n → ℝ)}
    (halg : QueryAlgorithm.IsMeasurableFamily alg) (ρ : Measure S) [IsProbabilityMeasure ρ]
    (hsucc : ∀ U : Matrix n n ℝ, HasOrthonormalCols U → ∀ b : n → ℝ,
      2 / 3 ≤ ρ.real {s | ‖WithLp.toLp 2 (b - (U * Matrix.diagonal d * Uᴴ) *ᵥ
        (alg s).run (hiddenRotationOracle U (Matrix.diagonal d)))‖ ≤ ε * ‖WithLp.toLp 2 b‖}) :
    κ * Real.log (1 / (4 * ε)) ≤ 2 * (q + 1) := by
  by_contra h
  replace h := not_le.mp h
  have hκpos : 0 < κ := by linarith
  have hlog : 2 * (q + 1) / κ < Real.log (1 / (4 * ε)) := by
    rw [div_lt_iff₀ hκpos]; linarith
  rw [Real.lt_log_iff_exp_lt (by positivity)] at hlog
  have hε' : ε < Real.exp (-(2 * (q + 1) / κ)) / 4 := by
    rw [Real.exp_neg, lt_div_iff₀ (by norm_num : (0:ℝ) < 4), inv_eq_one_div,
      lt_div_iff₀ (Real.exp_pos _)]
    rw [lt_div_iff₀ (by positivity)] at hlog
    nlinarith
  have hn : Nonempty n := by
    rcases isEmpty_or_nonempty n with h0 | h0
    · have h1 := hd.le_card_pos 0
      simp at h1
      exfalso
      linarith [(Nat.cast_nonneg q : (0:ℝ) ≤ q)]
    · exact h0
  obtain ⟨i⟩ := hn
  set b : n → ℝ := Pi.single i 1 with hb_def
  have hb : b ≠ 0 := by
    intro h0
    have := congrFun h0 i
    simp [hb_def] at this
  have hbpos : 0 < ‖WithLp.toLp 2 b‖ := norm_pos_iff.mpr (by simpa using hb)
  obtain ⟨U, hU, hfail⟩ := exists_le_measureReal_norm_sub_mulVec_ge hd hκ halg ρ hb
  have hsub := hsucc U hU b
  have hRm : Measurable fun s => ‖WithLp.toLp 2 (b - (U * Matrix.diagonal d * Uᴴ) *ᵥ
      (alg s).run (hiddenRotationOracle U (Matrix.diagonal d)))‖ := by
    have hO : Measurable (Function.uncurry fun _ : Unit =>
        hiddenRotationOracle U (Matrix.diagonal d)) := by
      have hc : Continuous (hiddenRotationOracle U (Matrix.diagonal d)) := by
        unfold hiddenRotationOracle; fun_prop
      exact hc.measurable.comp measurable_snd
    have hpair : Measurable fun s : S => (s, ()) := measurable_id.prodMk measurable_const
    have hrun : Measurable fun s => (alg s).run (hiddenRotationOracle U (Matrix.diagonal d)) :=
      (halg.measurable_run hO).comp hpair
    have hcont : Continuous fun v : n → ℝ =>
        ‖WithLp.toLp 2 (b - (U * Matrix.diagonal d * Uᴴ) *ᵥ v)‖ := by
      fun_prop
    exact hcont.measurable.comp hrun
  have hF : MeasurableSet {s | Real.exp (-(2 * (q + 1) / κ)) / 4 * ‖WithLp.toLp 2 b‖ ≤
      ‖WithLp.toLp 2 (b - (U * Matrix.diagonal d * Uᴴ) *ᵥ
        (alg s).run (hiddenRotationOracle U (Matrix.diagonal d)))‖} :=
    measurableSet_le measurable_const hRm
  have hsubset : {s | ‖WithLp.toLp 2 (b - (U * Matrix.diagonal d * Uᴴ) *ᵥ
      (alg s).run (hiddenRotationOracle U (Matrix.diagonal d)))‖ ≤ ε * ‖WithLp.toLp 2 b‖}
      ⊆ {s | Real.exp (-(2 * (q + 1) / κ)) / 4 * ‖WithLp.toLp 2 b‖ ≤
        ‖WithLp.toLp 2 (b - (U * Matrix.diagonal d * Uᴴ) *ᵥ
          (alg s).run (hiddenRotationOracle U (Matrix.diagonal d)))‖}ᶜ := by
    intro s hs
    have := mul_lt_mul_of_pos_right hε' hbpos
    simp only [Set.mem_ofPred_eq, Set.mem_compl_iff, not_le] at hs ⊢
    linarith
  have hmono := measureReal_mono (μ := ρ) hsubset
  rw [probReal_compl_eq_one_sub hF] at hmono
  linarith

/-- **The matrix–vector complexity of linear systems** (Shamir's theorem): let $\kappa \ge 2$,
$\varepsilon > 0$ and $\lvert n \rvert \ge 20(q + 3)^2$. If a randomized algorithm (a measurable
seeded family, seed law $\rho$) making $q$ adaptive matrix–vector products returns, for every
symmetric $\mathbf{A} \in \mathbb{R}^{n \times n}$ with spectrum in
$[-\kappa, -1] \cup [1, \kappa]$ (condition number at most $\kappa$) and every $\mathbf{b}$, an
$\hat{\mathbf{x}}$ with $\|\mathbf{b} - \mathbf{A}\hat{\mathbf{x}}\| \le \varepsilon\|\mathbf{b}\|$
with probability at least $\tfrac23$, then
$$\kappa\log\frac{1}{4\varepsilon} \le 2(q + 1) \,.$$
For symmetric $\mathbf{A}$ the products $\mathbf{A}^{\mathsf{H}}\mathbf{x}$ are the same, so this
covers the oracle $\mathbf{x} \mapsto (\mathbf{A}\mathbf{x}, \mathbf{A}^{\mathsf{H}}\mathbf{x})$ of
the source. MINRES needs $O(\kappa\log(1/\varepsilon))$ products on these spectra
(`Matrix.IsHermitian.norm_sub_mulVec_gmresIterate_le_two_mul_pow_div_two`), so the bound is
sharp up to the constant.
[Shamir2026, Theorem 1]; there $T \ge c\kappa\log(1/\varepsilon)$, for $\kappa \ge C$,
$\varepsilon \le c$ and $n = \Omega(T^2)$ with unspecified constants; here explicit; in the source
the output is the last query (one query fewer).
Result: linear-system-matvec-lower-bound -/
theorem mul_log_le_of_forall_le_measureReal_norm_sub_mulVec_le {κ ε : ℝ} {q : ℕ} (hκ : 2 ≤ κ)
    (hε : 0 < ε) (hn : 20 * (q + 3) ^ 2 ≤ Fintype.card n) {S : Type*} [MeasurableSpace S]
    {alg : S → QueryAlgorithm (n → ℝ) (n → ℝ) q (n → ℝ)}
    (halg : QueryAlgorithm.IsMeasurableFamily alg) (ρ : Measure S) [IsProbabilityMeasure ρ]
    (hsucc : ∀ A : Matrix n n ℝ, A.IsHermitian →
      spectrum ℝ A ⊆ Set.Icc (-κ) (-1) ∪ Set.Icc 1 κ → ∀ b : n → ℝ,
        2 / 3 ≤ ρ.real {s | ‖WithLp.toLp 2 (b - A *ᵥ (alg s).run A.mulVec)‖ ≤
          ε * ‖WithLp.toLp 2 b‖}) :
    κ * Real.log (1 / (4 * ε)) ≤ 2 * (q + 1) := by
  have hκ1 : (1 : ℝ) < κ := by linarith
  have hn' : 4 * ((q + 1 + 2) * (13 * (q + 3) + 1)) ≤ 3 * Fintype.card n := by
    nlinarith
  obtain ⟨d, hd⟩ :=
    exists_isChebyshevTwoIntervalSpectrum hκ1 (s := q + 1) (M := 13 * (q + 3)) hn'
  have hrun : ∀ (U : Matrix n n ℝ) (s : S),
      ((alg s).comapResponse Prod.fst).run (hiddenRotationOracle U (Matrix.diagonal d)) =
        (alg s).run (U * Matrix.diagonal d * Uᴴ).mulVec := fun U s => by
    rw [QueryAlgorithm.run_comapResponse]; rfl
  refine IsChebyshevTwoIntervalSpectrum.mul_log_le_of_forall_le_measureReal hd hκ hε
    (QueryAlgorithm.IsMeasurableFamily.comapResponse halg measurable_fst) ρ ?_
  intro U hU b
  have hU' : Uᴴ * U = 1 := hU
  have hUU : U * Uᴴ = 1 := HasOrthonormalCols.mul_conjTranspose_self_of_card_eq hU rfl
  have hA : (U * Matrix.diagonal d * Uᴴ).IsHermitian :=
    Matrix.isHermitian_mul_mul_conjTranspose U (Matrix.isHermitian_diagonal d)
  have hsp : spectrum ℝ (U * Matrix.diagonal d * Uᴴ) ⊆ Set.Icc (-κ) (-1) ∪ Set.Icc 1 κ := by
    let u : (Matrix n n ℝ)ˣ := ⟨U, Uᴴ, hUU, hU'⟩
    have hconj : spectrum ℝ (U * Matrix.diagonal d * Uᴴ) = spectrum ℝ (Matrix.diagonal d) :=
      spectrum.units_conjugate (a := Matrix.diagonal d) (u := u)
    rw [hconj, spectrum_diagonal]
    rintro _ ⟨i, rfl⟩
    exact hd.mem_Icc_union_Icc hκ1 i
  have h := hsucc _ hA hsp b
  simpa only [hrun] using h

/-- **The matrix–vector complexity of linear systems, Shamir's form**: for $\kappa \ge 2$,
$0 < \varepsilon \le e^{-4}$ and $\lvert n \rvert \ge 20(q + 3)^2$, a randomized algorithm making
$q$ adaptive matrix–vector products that solves every symmetric system with spectrum in
$[-\kappa, -1] \cup [1, \kappa]$ to relative residual $\varepsilon$ with probability at least
$\tfrac23$ (as in `NLAlib.mul_log_le_of_forall_le_measureReal_norm_sub_mulVec_le`) has
$$\kappa\log\frac{1}{\varepsilon} \le 4(q + 1) \,.$$
[Shamir2026, Theorem 1]; there $T \ge c\kappa\log(1/\varepsilon)$ with unspecified $c$ and $C$;
here an explicit constant. -/
theorem mul_log_le_four_mul_add_one_of_forall_le_measureReal_norm_sub_mulVec_le
    {κ ε : ℝ} {q : ℕ} (hκ : 2 ≤ κ) (hε : 0 < ε) (hε₀ : ε ≤ Real.exp (-4))
    (hn : 20 * (q + 3) ^ 2 ≤ Fintype.card n)
    {S : Type*} [MeasurableSpace S] {alg : S → QueryAlgorithm (n → ℝ) (n → ℝ) q (n → ℝ)}
    (halg : QueryAlgorithm.IsMeasurableFamily alg) (ρ : Measure S) [IsProbabilityMeasure ρ]
    (hsucc : ∀ A : Matrix n n ℝ, A.IsHermitian →
      spectrum ℝ A ⊆ Set.Icc (-κ) (-1) ∪ Set.Icc 1 κ → ∀ b : n → ℝ,
        2 / 3 ≤ ρ.real {s | ‖WithLp.toLp 2 (b - A *ᵥ (alg s).run A.mulVec)‖ ≤
          ε * ‖WithLp.toLp 2 b‖}) :
    κ * Real.log (1 / ε) ≤ 4 * (q + 1) := by
  have hL : 4 ≤ Real.log (1 / ε) := by
    rw [one_div, Real.log_inv]
    have := Real.log_le_log hε hε₀
    rw [Real.log_exp] at this
    linarith
  have h4 : Real.log (1 / (4 * ε)) = Real.log (1 / ε) - Real.log 4 := by
    rw [show 1 / (4 * ε) = (1 / ε) / 4 by ring,
      Real.log_div (by positivity) (by norm_num)]
  have hlog4 : Real.log 4 < 1.39 := by
    have h2 : Real.log 4 = 2 * Real.log 2 := by
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]
      norm_num
    have := Real.log_two_lt_d9
    norm_num at this
    linarith
  have h := mul_log_le_of_forall_le_measureReal_norm_sub_mulVec_le hκ hε hn halg ρ hsucc
  rw [h4] at h
  have hk : 0 ≤ κ := by linarith
  have hlog4' : 0 ≤ Real.log 4 := Real.log_nonneg (by norm_num)
  nlinarith [mul_nonneg hk (sub_nonneg.mpr hL), mul_nonneg hk (sub_nonneg.mpr hlog4.le),
    mul_le_mul_of_nonneg_left hlog4.le hk, mul_nonneg (by positivity : (0:ℝ) ≤ q + 1) hk]

end NLAlib
