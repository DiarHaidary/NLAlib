import NLAlib

/-!
# The catalog of program specifications

Lists every theorem of `NLAlib` whose conclusion is a `NLAlib.Computation.RoutineSpec`, a
`NLAlib.Computation.Spec` or a `NLAlib.Computation.Triple`, grouped by file and sorted by line:
its name, `file:line`, its hypotheses, and the precondition, program, footprint and postcondition
of its conclusion, each printed on its own. A prover looks a step's specification up here
(`grep -n zhermScale SpecCatalog.md`) instead of reading the files.

Run `SPEC_CATALOG=<out.md> lake env lean NLAlibTools/SpecCatalog.lean` to write the catalog;
without the variable (as in `lake build NLAlibTools`) it is computed and only counted.
Instance arguments and the implicit sorts (`P ι K C : Type`) are left out of the hypotheses.
-/

-- A tools file: `run_meta` is its point.
set_option linter.hashCommand false

open Lean Meta

namespace NLAlibTools.SpecCatalog

/-- The specification judgements, with the number of trailing arguments
(`m I pre prog fp post` or `m I pre prog post`). -/
def heads : List (Name × Nat) :=
  [(``NLAlib.Computation.RoutineSpec, 6), (``NLAlib.Computation.Spec, 6),
    (``NLAlib.Computation.Triple, 5)]

/-- One entry: file, line, Markdown text. -/
structure Entry where
  /-- The source file. -/
  file : String
  /-- The declaration's line. -/
  line : Nat
  /-- The entry's Markdown. -/
  text : String

/-- Pretty-print at width 100. -/
def pp (e : Expr) : MetaM String := do
  return (← ppExpr e).pretty 100

/-- Indent every line after the first by `n` spaces. -/
def indent (n : Nat) (s : String) : String :=
  s.replace "\n" ("\n" ++ "".pushn ' ' n)

/-- The hypotheses of a declaration as binders, without instances and sort variables. -/
def binders (xs : Array Expr) : MetaM (List String) := do
  let mut out := []
  for x in xs do
    let d ← x.fvarId!.getDecl
    if d.binderInfo.isInstImplicit then continue
    if (← whnfR d.type).isSort then continue
    let t ← pp d.type
    let n := d.userName.eraseMacroScopes.toString
    let (l, r) := match d.binderInfo with
      | .implicit => ("{", "}") | .strictImplicit => ("⦃", "⦄") | _ => ("(", ")")
    out := out ++ [s!"{l}{n} : {indent 4 t}{r}"]
  return out

/-- The entry of a theorem, if its conclusion is a specification judgement. -/
def entry? (env : Environment) (n : Name) (ty : Expr) : MetaM (Option Entry) := do
  forallTelescope ty fun xs concl₀ => do
    -- a statement may bind abbreviations (`let M := …`) before its judgement
    let concl ← zetaReduce concl₀
    let some (h, k) := heads.find? (concl.isAppOf ·.1) | return none
    let args := concl.getAppArgs
    if args.size < k then return none
    let a := args.extract (args.size - k) args.size
    let some idx := env.getModuleIdxFor? n | return none
    let mod := env.header.moduleNames[idx.toNat]!
    let file := (mod.toString.replace "." "/") ++ ".lean"
    let line := (← findDeclarationRanges? n).map (·.selectionRange.pos.line) |>.getD 0
    let fields := if k == 6 then
        [("mode", a[0]!), ("pre", a[2]!), ("program", a[3]!), ("footprint", a[4]!),
          ("post", a[5]!)]
      else [("mode", a[0]!), ("pre", a[2]!), ("program", a[3]!), ("post", a[4]!)]
    let mut body := ""
    for b in ← binders xs do
      body := body ++ s!"  {b}\n"
    body := body ++ s!"⊢ {h.getString!}\n"
    for (l, e) in fields do
      body := body ++ s!"  {l}: {indent 4 (← pp e)}\n"
    return some { file, line, text := s!"### `{n}`\n{file}:{line}\n```\n{body}```\n" }

/-- Every entry of `NLAlib`, grouped by file, sorted by line. -/
def entries : MetaM (Array Entry) := do
  let env ← getEnv
  let mut out := #[]
  for (n, c) in env.constants.toList do
    let .thmInfo t := c | continue
    if n.isInternal || isPrivateName n then continue
    let some idx := env.getModuleIdxFor? n | continue
    unless (`NLAlib).isPrefixOf env.header.moduleNames[idx.toNat]! do continue
    if let some e ← entry? env n t.type then out := out.push e
  return out.qsort fun a b => a.file < b.file || (a.file == b.file && a.line < b.line)

/-- The catalog as Markdown. -/
def render (es : Array Entry) : String := Id.run do
  let mut s := "# Program specification catalog\n\n" ++
    s!"Generated by `NLAlibTools/SpecCatalog.lean`: {es.size} theorems of `NLAlib` concluding " ++
    "`RoutineSpec`, `Spec` or `Triple`, by file and line. Hypotheses omit instances and the " ++
    "sorts `P ι K C`.\n"
  let mut cur := ""
  for e in es do
    if e.file != cur then
      cur := e.file
      s := s ++ s!"\n## {cur}\n\n"
    s := s ++ e.text ++ "\n"
  return s

open NLAlib NLAlib.Computation NLAlib.Computation.Builder in
run_meta do
  let es ← entries
  match ← IO.getEnv "SPEC_CATALOG" with
  | some path =>
    IO.FS.writeFile path (render es)
    logInfo m!"{es.size} specifications written to {path}"
  | none => unless es.size > 0 do throwError "no specifications found"

end NLAlibTools.SpecCatalog
