import NLAlib
open Lean Meta Elab Command

/-! # Duplicate statements

Reports theorems of the library whose statements coincide, so that a proof that re-derives an
existing result can be pointed at the existing one. Every theorem declared in an `NLAlib` module
(private ones included) is normalised: universe parameters are instantiated uniformly to `0`,
metadata is erased and lambdas are eta-reduced; binder names and binder kinds never matter, since
`Expr.hash` ignores them. Theorems are bucketed by the hash of the normalised statement and each
bucket is split into classes by `isDefEq` at reducible transparency. Output, one line per class:

1. `private-vs-public`: delete the private lemma and use the public one;
2. `public-vs-public`: two public theorems with one statement;
3. `private-vs-private`: the same private lemma in several files, a candidate for a public one;
4. `mathlib`: a library theorem whose statement a Mathlib (or core) theorem already has.

Skipped: auto-generated declarations (`eq_1`, `eq_def`, `match_`, `proof_`, `_`-prefixed names,
`injEq`, `sizeOf_spec`, the `foo_def` lemma of `irreducible_def foo`), instances, structure
projections, deprecated declarations and aliases (a theorem whose proof is another theorem of
its class). Statements that agree only up to argument order, an extra hypothesis or unfolding
beyond reducible transparency are not found.

Run with `lake env lean scripts/Duplicates.lean`; replace the first line by a list of imports to
check part of the library. Theorems declared in the running file itself count as library theorems,
so a candidate statement can be checked by appending it to a copy. It is a report and exits 0; set
the environment variable `NLALIB_DUPLICATES_STRICT=1` to make classes 1 and 2 errors. -/

/-- Erase metadata and eta-reduce every lambda. -/
partial def dupNormalize (e : Expr) : Expr :=
  e.replace fun
    | .mdata _ b => some (dupNormalize b)
    | .lam n d b bi => some (Expr.lam n (dupNormalize d) (dupNormalize b) bi).eta
    | _ => none

/-- The statement of a theorem with its universe parameters set to `0`, normalised. -/
def dupKey (t : TheoremVal) : Expr :=
  dupNormalize (t.type.instantiateLevelParams t.levelParams (t.levelParams.map fun _ => Level.zero))

/-- Declarations generated by Lean or Mathlib rather than written. -/
def dupGenerated (env : Environment) (n : Name) : Bool :=
  let u := privateToUserName n
  let last := match u with | .str _ s => s | _ => ""
  u.isInternalDetail || ["eq_def", "eq_unfold", "injEq", "inj", "sizeOf_spec"].contains last
    || isInstanceCore env n || env.isProjectionFn n || Linter.isDeprecated env n
    || (last.endsWith "_def" &&
          env.contains (u.getPrefix.str (String.ofList (last.toList.take (last.length - 4)))))

/-- `n` is an alias: its proof is, up to eta, a constant in `names`. -/
def dupIsAlias (env : Environment) (names : Array Name) (n : Name) : Bool :=
  match env.find? n with
  | some (.thmInfo t) => match t.value.eta.getAppFn with
    | .const c _ => c != n && names.contains c
    | _ => false
  | _ => false

run_cmd do
  let env ← getEnv
  let mods := env.header.moduleNames
  let isLib : Array Bool := mods.map fun m => (`NLAlib).isPrefixOf m
  -- Declarations of the file running the script count as library ones (for testing a statement).
  let modOf (n : Name) : Name := match env.getModuleIdxFor? n with
    | some i => mods[i.toNat]!
    | none => env.mainModule
  let inLib (n : Name) : Bool := match env.getModuleIdxFor? n with
    | some i => isLib[i.toNat]!
    | none => true
  let decls := env.constants.map₁.toList ++ env.constants.map₂.toList
  -- Library theorems by statement hash.
  let mut lib : Std.HashMap UInt64 (Array (Name × Expr)) := {}
  let mut count : Nat := 0
  for (n, ci) in decls do
    if let .thmInfo t := ci then
      if inLib n && !dupGenerated env n then
        count := count + 1
        let k := dupKey t
        lib := lib.alter k.hash fun l? => some ((l?.getD #[]).push (n, k))
  -- Mathlib and core theorems in the same buckets.
  let mut ext : Std.HashMap UInt64 (Array (Name × Expr)) := {}
  for (n, ci) in decls do
    if let .thmInfo t := ci then
      if !inLib n then
        let k := dupKey t
        if lib.contains k.hash && !dupGenerated env n then
          ext := ext.alter k.hash fun l? => some ((l?.getD #[]).push (n, k))
  -- Split each bucket into `isDefEq` classes; `(library members, external members)`.
  let mut classes : Array (Array Name × Array Name) := #[]
  for (h, ms) in lib do
    let all := ms.map (·, true) ++ (ext.getD h #[]).map (·, false)
    if all.size < 2 then continue
    let mut cls : Array (Expr × Array Name × Array Name) := #[]
    for ((n, k), isL) in all do
      let mut placed := false
      for i in [0:cls.size] do
        let (rep, ls, es) := cls[i]!
        if ← liftTermElabM (withReducible (isDefEq rep k)) then
          cls := cls.set! i (rep, if isL then ls.push n else ls, if isL then es else es.push n)
          placed := true
          break
      unless placed do
        cls := cls.push (k, if isL then #[n] else #[], if isL then #[] else #[n])
    for (_, ls, es) in cls do
      let ls := ls.filter fun n => !dupIsAlias env (ls ++ es) n
      let es := es.filter fun n => !dupIsAlias env (ls ++ es) n
      if ls.size + es.size ≥ 2 && ls.size ≥ 1 then classes := classes.push (ls, es)
  let fmt (n : Name) : String :=
    s!"{privateToUserName n}{if isPrivateName n then " (private)" else ""} [{modOf n}]"
  -- Private members first, then by module; library members before Mathlib ones.
  let key (n : Name) : String := s!"{if isPrivateName n then 0 else 1}{modOf n}"
  let line (ns : Array Name) : String :=
    " = ".intercalate ((ns.qsort fun a b => key a < key b).toList.map fmt)
  let kind (ls es : Array Name) : String :=
    if !es.isEmpty then "mathlib"
    else if ls.any isPrivateName && ls.any (!isPrivateName ·) then "private-vs-public"
    else if ls.all (!isPrivateName ·) then "public-vs-public"
    else "private-vs-private"
  let order := ["private-vs-public", "public-vs-public", "private-vs-private", "mathlib"]
  let strict := (← IO.getEnv "NLALIB_DUPLICATES_STRICT") == some "1"
  let mut out : Array String := #[]
  let mut serious : Nat := 0
  for o in order do
    let mut group : Array String := #[]
    for (ls, es) in classes do
      if kind ls es == o then
        group := group.push s!"[{o}] {line ls}{if es.isEmpty then "" else " = " ++ line es}"
        if o == "private-vs-public" || o == "public-vs-public" then serious := serious + 1
    out := out ++ group.qsort (· < ·)
  let summary := s!"duplicates: {count} library theorems, {classes.size} classes " ++
    s!"({serious} private-vs-public or public-vs-public)"
  let report := "\n".intercalate (out.toList ++ [summary])
  if strict && serious > 0 then logError report else logInfo report
